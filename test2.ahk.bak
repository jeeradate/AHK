f3::{
	startover:
	age := InputBox("What is your ager?", "age", "h100 w100")
	if age.result = "Cancel"
	{
		MsgBox("let tel me your age")
		goto startover
	}
	else{
		MsgBox("You are " age.value "  olds")
	}

}

